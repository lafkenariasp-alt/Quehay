{
  "expo": {
    "name": "Qué Hay",
    "slug": "quehay",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF7F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.quehay.app"
    },
    "android": {
      "package": "cl.quehay.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Qué Hay usa tus fotos para que compartas tus recetas y cómo te quedaron.",
          "cameraPermission": "Qué Hay usa la cámara para que fotografíes tus platos."
        }
      ]
    ],
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Qué Hay",
      "shortName": "Qué Hay",
      "backgroundColor": "#FBF7F0",
      "themeColor": "#C93F18",
      "lang": "es"
    },
    "experiments": {
      "baseUrl": "/Quehay"
    }
  }
}
